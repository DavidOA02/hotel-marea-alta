{
  "name": "@marea/api",
  "version": "2.0.0",
  "private": true,
  "description": "API del Hotel Marea Alta — NestJS 11 + PostgreSQL (pg) + túnel SSH opcional (ssh2)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@marea/shared": "2.0.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2": "1.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "^5.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "8.23.1",
    "@types/ssh2": "1.15.6",
    "@types/supertest": "^6.0.2",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": { "^@marea/shared$": "<rootDir>/../../../packages/shared/src" }
  }
}
