# Copiar como apps/api/.env.sandbox. Completar solo credenciales de prueba.
# Nunca copiar tokens de producción; no compartir ni subir el archivo completado.
NODE_ENV=development
PUERTO=4000
TRUST_PROXY=false
CORS_ORIGENES=http://localhost:3000,http://127.0.0.1:3000
WEB_URL=http://localhost:3000
# URL pública HTTPS de esta API sandbox (terminar en /api) para MP/Niubiz.
API_URL_PUBLICA=

PGHOST=localhost
PGPORT=5432
PGDATABASE=hotel_marea_alta_sandbox
PGUSER=postgres
PGPASSWORD=
# Generar dos secretos locales independientes. No usar los de producción.
JWT_SECRETO=
JWT_SECRETO_RENOVACION=

# Procesos desactivados: consultar los pendientes manualmente desde el panel.
PROCESOS_EN_SEGUNDO_PLANO=false
CORREOS_PROGRAMADOS=false
# Vacíos para que los correos solo se registren, sin destinatarios externos.
SMTP_HOST=
SMTP_PUERTO=
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=
CORREO_RESPONDER_A=

# Probar un proveedor a la vez: pagos reales de prueba + OSE simulado,
# o Nubefact DEMO + pasarela simulada.
PASARELA=simulada
FACTURACION=simulado
HOTEL_RUC=
HOTEL_RAZON_SOCIAL=Hotel Marea Alta - Pruebas

# Culqi: activar PASARELA=culqi y mantener FACTURACION=simulado.
CULQI_LLAVE_PUBLICA=
CULQI_LLAVE_SECRETA=

# Mercado Pago: PASARELA=mercadopago, vendedor/comprador de prueba.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRETO=
# Solo true si el panel confirma vendedor de prueba (APP_USR no lo garantiza).
MP_CUENTA_PRUEBA_CONFIRMADA=false

# Niubiz: PASARELA=niubiz, credenciales entregadas para sandbox.
NIUBIZ_COMERCIO=
NIUBIZ_USUARIO=
NIUBIZ_CLAVE=
NIUBIZ_PRODUCCION=false
NIUBIZ_DEVOLUCIONES_URL=https://apisandbox.vnforappstest.com
NIUBIZ_CONSULTA_DEVOLUCIONES_URL=https://apitestenv.vnforapps.com

# Nubefact: FACTURACION=nubefact, PASARELA=simulada, cuenta DEMO confirmada.
# La URL de API no distingue una cuenta DEMO de una productiva.
NUBEFACT_RUTA=
NUBEFACT_TOKEN=
NUBEFACT_CUENTA_DEMO_CONFIRMADA=false
# Ajustar a las seis series registradas en la cuenta DEMO.
SERIE_BOLETA=B001
SERIE_FACTURA=F001
SERIE_NC_BOLETA=BC01
SERIE_NC_FACTURA=FC01
SERIE_ND_BOLETA=BD01
SERIE_ND_FACTURA=FD01
