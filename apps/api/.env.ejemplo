# ===== API Hotel Marea Alta — copia este archivo como .env =====
PUERTO=4000
# Orígenes permitidos (web Next.js)
CORS_ORIGENES=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=hotel_marea_alta
PGUSER=postgres
PGPASSWORD=postgres

# Secretos JWT: cámbialos por textos largos y aleatorios en producción
JWT_SECRETO=cambia-este-secreto-de-acceso-por-uno-largo
JWT_SECRETO_RENOVACION=cambia-este-secreto-de-renovacion-por-otro-largo

# Túnel SSH opcional (ssh2): si PostgreSQL está en un VPS al que solo se llega por SSH.
# Con SSH_HOST definido, la API abre el túnel y se conecta a PGHOST:PGPORT *desde* el servidor.
# SSH_HOST=mi-vps.ejemplo.pe
# SSH_PUERTO=22
# SSH_USUARIO=deploy
# SSH_LLAVE=C:\Users\david\.ssh\id_ed25519
# SSH_CLAVE=            # (alternativa a la llave)

# URLs públicas: enlaces de los correos y retorno/avisos de las pasarelas de pago
WEB_URL=http://localhost:3000
# API_URL_PUBLICA=https://api.mareaalta.pe/api   # debe ser accesible desde Internet para los avisos de Mercado Pago

# Datos del emisor (correos y comprobantes)
# HOTEL_RUC=20000000000
# HOTEL_RAZON_SOCIAL=Marea Alta Hoteles S.A.C.
# HOTEL_WHATSAPP=51999999999

# ===== Correos automáticos (SMTP) =====
# Sin SMTP_HOST los correos se guardan y se marcan como «Simulado» (no se envían).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PUERTO=587                 # 465 = TLS directo
# SMTP_USUARIO=
# SMTP_CLAVE=
# CORREO_REMITENTE=Hotel Marea Alta <reservas@mareaalta.pe>
# CORREO_RESPONDER_A=reservas@mareaalta.pe
# PROCESOS_EN_SEGUNDO_PLANO=true  # envío de correos, recordatorios, encuestas y reintentos de comprobantes
# CORREOS_PROGRAMADOS=true        # recordatorio 2 días antes de la llegada y encuesta tras el check-out

# ===== Pagos en línea =====
# PASARELA=simulada | culqi | mercadopago | niubiz   (sin definir: simulada en desarrollo, ninguna en producción)
# Culqi (CulqiPanel → Desarrollo → API Keys)
# CULQI_LLAVE_PUBLICA=pk_test_...
# CULQI_LLAVE_SECRETA=sk_test_...
# Mercado Pago (Tus integraciones → Credenciales; el secreto está en Webhooks)
# MP_ACCESS_TOKEN=TEST-...
# MP_WEBHOOK_SECRETO=
# Niubiz (credenciales que entrega Niubiz al afiliar el comercio)
# NIUBIZ_COMERCIO=
# NIUBIZ_USUARIO=
# NIUBIZ_CLAVE=
# NIUBIZ_PRODUCCION=false

# ===== Facturación electrónica SUNAT =====
# FACTURACION=simulado | nubefact   (sin definir: simulado en desarrollo, desactivada en producción)
# NUBEFACT_RUTA=https://api.nubefact.com/api/v1/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NUBEFACT_TOKEN=
# SERIE_BOLETA=B001
# SERIE_FACTURA=F001
# SERIE_NC_BOLETA=BC01          # notas de crédito que modifican boletas
# SERIE_NC_FACTURA=FC01         # notas de crédito que modifican facturas
