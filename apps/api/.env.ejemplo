# ===== API Hotel Marea Alta — copia este archivo como .env =====
PUERTO=4000
# Orígenes permitidos (web Next.js)
CORS_ORIGENES=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=hotel_marea_alta
PGUSER=postgres
PGPASSWORD=postgres

# Secretos JWT: cámbialos por textos largos y aleatorios en producción
JWT_SECRETO=cambia-este-secreto-de-acceso-por-uno-largo
JWT_SECRETO_RENOVACION=cambia-este-secreto-de-renovacion-por-otro-largo

# Túnel SSH opcional (ssh2): si PostgreSQL está en un VPS al que solo se llega por SSH.
# Con SSH_HOST definido, la API abre el túnel y se conecta a PGHOST:PGPORT *desde* el servidor.
# SSH_HOST=mi-vps.ejemplo.pe
# SSH_PUERTO=22
# SSH_USUARIO=deploy
# SSH_LLAVE=C:\Users\david\.ssh\id_ed25519
# SSH_CLAVE=            # (alternativa a la llave)
